<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="LogicPort wire frames — decoded 2026-10-28" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="20" y="10" width="900" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="subtitle" value="Source: LogicPort.exe decompile (sha 343745f3). The 16-bit field is the sample-rate word, not an address." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="20" y="44" width="900" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="c1label" value="C1 — write" style="text;html=1;fontSize=14;fontStyle=1;align=right;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="20" y="90" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1b0" value="0xC1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#0F1E36;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="130" y="90" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1b1" value="rate lo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#B08A00;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="240" y="90" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1b2" value="rate hi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#B08A00;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="350" y="90" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1b3" value="len−1 lo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#7A7A7A;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="460" y="90" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1b4" value="len−1 hi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#7A7A7A;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="570" y="90" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1b5" value="payload (1–5 bytes)&#10;usbWriteByte/Word/Dword/40" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#4C7A3F;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="680" y="90" width="200" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c1note" value="Bytes 1–2: sample-rate word, little-endian — there is no address field. Bytes 3–4: payload length − 1. Command identity comes from sequence position and payload size only. Every C1 drains exactly 3 response bytes (1000 ms)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="130" y="154" width="750" height="46" as="geometry"/>
    </mxCell>
    <mxCell id="c2label" value="C2 — read request" style="text;html=1;fontSize=14;fontStyle=1;align=right;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="20" y="240" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2b0" value="0xC2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#0F1E36;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="130" y="240" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2b1" value="rate lo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#B08A00;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="240" y="240" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2b2" value="rate hi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#B08A00;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="350" y="240" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2b3" value="N lo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#2E6DA4;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="460" y="240" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2b4" value="N hi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#2E6DA4;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="570" y="240" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2note" value="N = bytes requested. It is the wire field and the FT_Read count; a short read fails with no retry (2000 ms). Status poll = C2 with N = 1. Sample fetch = one C2 per plane chunk." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="130" y="304" width="750" height="46" as="geometry"/>
    </mxCell>
    <mxCell id="c3label" value="C3 — stop" style="text;html=1;fontSize=14;fontStyle=1;align=right;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="20" y="390" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c3b0" value="0xC3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#0F1E36;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="130" y="390" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c3b1" value="rate lo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#B08A00;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="240" y="390" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c3b2" value="rate hi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#B08A00;fontSize=14;" vertex="1" parent="1">
