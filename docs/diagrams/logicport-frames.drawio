    </mxCell>
    <mxCell id="c3b3" value="00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#7A7A7A;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="460" y="390" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c3b4" value="00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#7A7A7A;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="570" y="390" width="110" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c3note" value="Stop, and the clock-select guard: the sender emits C3 first whenever Int(rate / 65536) differs from the cached select. It is also the capture-abort command." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="130" y="454" width="750" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="legend" value="Legend:  opcode (dark)  ·  sample-rate word (amber)  ·  length / constant (grey)  ·  requested count (blue)  ·  payload (green)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="20" y="510" width="900" height="24" as="geometry"/>
