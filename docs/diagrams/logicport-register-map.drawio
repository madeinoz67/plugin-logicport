ign=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="842" y="282" width="250" height="24" as="geometry"/></mxCell><mxCell id="h4" value="<b>Sample area</b><br><font style='font-size:10px'>segment 0x0200 · base 0x02000000</font>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1116" y="70" width="250" height="46" as="geometry"/></mxCell><mxCell id="r4_0" value="<b>0x…0000</b> &nbsp; cursor A (2 bytes BE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="126" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_1" value="<b>0x…0100</b> &nbsp; cursor B (2 bytes BE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="152" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_2" value="<b>0x…1000</b> &nbsp; D0–D7  set A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="178" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_3" value="<b>0x…2000</b> &nbsp; D8–D15 set A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="204" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_4" value="<b>0x…3000</b> &nbsp; D16–D23 set A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="230" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_5" value="<b>0x…4000</b> &nbsp; D24–D31 set A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="256" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_6" value="<b>0x…5000</b> &nbsp; D0–D7  set B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="282" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_7" value="<b>0x…6000</b> &nbsp; D8–D15 set B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="308" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_8" value="<b>0x…7000</b> &nbsp; D16–D23 set B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="334" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_9" value="<b>0x…8000</b> &nbsp; D24–D31 set B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="360" width="250" height="24" as="geometry"/></mxCell><mxCell id="r4_10" value="<b>0x…9000</b> &nbsp; D32/CLK1 + D33/CLK2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1116" y="386" width="250" height="24" as="geometry"/></mxCell><mxCell id="h5" value="<b>Clock bytes</b><br><font style='font-size:10px'>segment 0x2000 · base 0x20000000</font>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="70" width="250" height="46" as="geometry"/></mxCell><mxCell id="r5_0" value="<b>0x20000000</b> &nbsp; clock byteA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1390" y="126" width="250" height="24" as="geometry"/></mxCell><mxCell id="r5_1" value="<b>0x20000001</b> &nbsp; clock byteB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1390" y="152" width="250" height="24" as="geometry"/></mxCell><mxCell id="h6" value="<b>Frequency counter</b><br><font style='font-size:10px'>segment 0x4000 · base 0x40000000</font>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1664" y="70" width="250" height="46" as="geometry"/></mxCell><mxCell id="r6_0" value="<b>0x40000000</b> &nbsp; channel select / marker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1664" y="126" width="250" height="24" as="geometry"/></mxCell><mxCell id="r6_1" value="<b>0x40000001</b> &nbsp; count dword" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1664" y="152" width="250" height="24" as="geometry"/></mxCell><mxCell id="r6_2" value="<b>0x40000005</b> &nbsp; status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1664" y="178" width="250" height="24" as="geometry"/></mxCell><mxCell id="note" value="<b>Addressing rule.</b> A register is reached by a <b>C3</b> frame carrying the <i>segment</i> = address &gt;&gt; 16, then a <b>C1</b>/<b>C2</b> frame whose 16-bit field is the low half of the address. The segment is cached, so one C3 covers a run of accesses in the same bank — and a segment select must be followed by a <i>write</i> before any read.<br><b>Widths.</b> 1-byte, 2-byte LE, 4-byte LE, and 40-bit LE payloads. The two EDGE planes and two pattern planes are 40-bit: bit <i>k</i> is channel <i>k</i>, 34 channels, top 6 bits zero.<br><b>Encodings.</b> EDGE is four-state per channel (0 none, 1 plane A, 2 plane B, 3 both). PATTERN is ternary (0 don't care, 1 must-be-0, 2 must-be-1) and never uses 3." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1800" height="90" as="geometry"/></mxCell></root></mxGraphModel>