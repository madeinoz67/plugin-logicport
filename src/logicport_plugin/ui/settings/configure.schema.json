{
  "properties": {
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "threshold_v": {
            "type": "number"
          }
        },
        "required": [
          "channel",
          "threshold_v"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sample_rate_hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "trigger": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "immediate",
            "software",
            "external",
            "edge"
          ]
        },
        "source_channel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "slope": {
          "enum": [
            "rising",
            "falling"
          ]
        },
        "level_v": {
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "edge"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_channel",
              "slope",
              "level_v"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_channel"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "channels",
    "configuration_id",
    "sample_count",
    "sample_rate_hz",
    "trigger"
  ],
  "$id": "urn:otdp:action:logic_analyser.configure:1.0.0:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
