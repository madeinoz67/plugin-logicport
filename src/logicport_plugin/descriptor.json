{
  "otdp_version": "0.2.2",
  "descriptor_version": "0.1.0",
  "id": "intronix.logicport",
  "display_name": "Intronix LogicPort",
  "description": "Intronix LogicPort 34-channel USB logic analyser (FTDI VID 0x0403 PID 0xDC48). Framing, FPGA load, status and sample-plane decode are implemented from the reverse-engineered protocol; configuration-write destination registers are open items and refuse loudly. Not hardware qualified.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "Intronix",
    "model": "LogicPort",
    "firmware_policy": "commissioned"
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "logicport_plugin.adapter:create_plugin",
      "api_version": "1.1",
      "version": "0.1.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
  "transport": {
    "type": "custom",
    "connection_key": "logicport",
    "settings": {
      "protocol_reference": "LogicPort-Protocol.md section 3 wire framing; ftdi_control dialect pending a pinned transport-provider contract"
    }
  },
  "capabilities": [
    "identify",
    "read",
    "write",
    "invoke",
    "reset"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "idempotent",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2500,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "write": {
      "timeout_ms": 1000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "dispatched"
    },
    "invoke": {
      "timeout_ms": 60000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "reset": {
      "timeout_ms": 5000,
      "side_effect": "state_change",
      "retry": "idempotent",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "rate_word",
      "description": "Packed C1/C2 rate and clock-select word (LogicPort-Protocol.md section 3.1); the Hz-to-rate-value conversion is an open item",
      "type": "int",
      "access": "rw",
      "semantic": "configuration",
      "unit": "count",
      "range": [
        0,
        4294967295
      ],
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "rate_word"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      },
      "write_policy": {
        "effect": "setting",
        "completion": "dispatched",
        "retry": "never"
      }
    },
    {
      "name": "threshold_v",
      "description": "Input threshold in volts; converts to the 10-bit DAC code of LogicPort-Protocol.md section 5a (about 14.3 mV per code)",
      "type": "float",
      "access": "rw",
      "semantic": "setpoint",
      "unit": "V",
      "range": [
        -6.0,
        6.0
      ],
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "threshold_v"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      },
      "write_policy": {
        "effect": "setting",
        "completion": "dispatched",
        "retry": "never"
      }
    },
    {
      "name": "status",
      "description": "Status byte of register 0x100000 (LogicPort-Protocol.md section 5c): bit 0 capture complete, bit 1 immediate trigger, bits 6:5 pre-trigger fill phase",
      "type": "int",
      "access": "ro",
      "semantic": "state",
      "unit": "count",
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "status"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "frequency_a",
      "description": "Frequency-counter channel 0 in Hz (count x 10 from register 0x40000001 after the channel select on 0x40000000). The read switches the counter multiplexer: a device side effect the verb-wide read policy cannot declare (standards gap, disclosed here).",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "unit": "Hz",
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "frequency_a"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "frequency_b",
      "description": "Frequency-counter channel 1 in Hz (count x 10 from register 0x40000001 after the channel select on 0x40000000). The read switches the counter multiplexer: a device side effect the verb-wide read policy cannot declare (standards gap, disclosed here).",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "unit": "Hz",
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "frequency_b"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "frequency_c",
      "description": "Frequency-counter channel 2 in Hz (count x 10 from register 0x40000001 after the channel select on 0x40000000). The read switches the counter multiplexer: a device side effect the verb-wide read policy cannot declare (standards gap, disclosed here).",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "unit": "Hz",
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "frequency_c"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "frequency_d",
      "description": "Frequency-counter channel 3 in Hz (count x 10 from register 0x40000001 after the channel select on 0x40000000). The read switches the counter multiplexer: a device side effect the verb-wide read policy cannot declare (standards gap, disclosed here).",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "unit": "Hz",
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "frequency_d"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "trigger_position",
      "description": "Trigger position word of register 0x10000A (LogicPort-Protocol.md section 5b)",
      "type": "int",
      "access": "ro",
      "semantic": "state",
      "unit": "count",
      "hazard_class": "none",
      "binding": {
        "kind": "adapter",
        "key": "trigger_position"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
